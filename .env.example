# Copy to .env before `docker compose up`. The .env file is ignored by git.
#
# Leave JWT_SECRET empty when running with `mvnw spring-boot:run`: the dev profile then generates a
# key at target/jwt-dev.key and reuses it across restarts. `docker compose up` needs it set, because
# outside the dev and test profiles the application refuses to start on a missing or short secret.
# Generate one with `openssl rand -base64 32`; it must decode to at least 32 bytes.
JWT_SECRET=

# Seeded accounts on an empty database. The seeder skips itself once rows exist.
ADMIN_EMAIL=admin@todo.local
DEMO_EMAIL=demo@todo.local
SEED_DEMO_DATA=true

JWT_EXPIRATION_MINUTES=120
RATE_LIMIT_PER_MINUTE=10
REMINDERS_ENABLED=true
PURGE_ENABLED=false
